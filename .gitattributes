* text=auto

# Windows-native scripts and project files
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf

# Source, documentation, and portable scripts
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.inc text eol=lf
*.sh text eol=lf
Makefile text eol=lf
makefile text eol=lf
makefile.* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.py text eol=lf

# Binary assets and archives
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.dll binary
*.exe binary
*.bin binary
*.zip binary
*.7z binary
*.rar binary
